# Normalize source text across platforms; binary assets retain their bytes.
* text=auto
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.svg text eol=lf
*.png binary
*.ico binary
*.pdf binary
*.epub binary
*.wav binary
