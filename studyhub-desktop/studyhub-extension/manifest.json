{
  "manifest_version": 3,
  "name": "masterStudy Companion — Capturas",
  "version": "1.1.0",
  "description": "Captura páginas, textos e conteúdos para o Hub do masterStudy Desktop.",
  "browser_specific_settings": {
    "gecko": {
      "id": "studyhub-companion@studyhub.local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:47820/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Abrir masterStudy Companion"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "StudyHub Companion"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
