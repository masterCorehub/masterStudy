{
  "name": "studyhub-desktop",
  "version": "1.1.2",
  "private": true,
  "description": "Desktop learning workspace for StudyHub / Silk Learning",
  "desktopName": "com.studyhub.desktop",
  "author": "OpenAI Codex",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:web": "vite --host 127.0.0.1",
    "preview:web": "vite preview --host 127.0.0.1",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && electron . --ozone-platform=x11",
    "build": "vite build",
    "test": "node --test",
    "test:e2e": "playwright test",
    "test:packaged": "node scripts/smoke-packaged.mjs",
    "check": "npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage",
    "dist:linux:bundle": "bash packaging/linux/build-bundle.sh"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/por": "^1.0.0",
    "ffmpeg-static": "^5.3.0",
    "kokoro-js": "^1.2.1",
    "remark-rehype": "^11.1.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "@lezer/markdown": "^1.7.2",
    "@mlc-ai/web-llm": "^0.2.84",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tiptap/extension-highlight": "^3.27.3",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/extension-text-align": "^3.27.3",
    "@tiptap/extension-underline": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "^10.5.2",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.4",
    "dompurify": "^3.4.12",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "epubjs": "^0.3.93",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "material-symbols": "^0.45.6",
    "mermaid": "^11.4.1",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.61.1",
    "postcss": "^8.5.25",
    "prettier": "^3.6.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^3.4.17",
    "unified": "^11.0.5",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.1",
    "vite": "^6.4.3",
    "wait-on": "^8.0.5",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    }
  },
  "build": {
    "appId": "com.studyhub.desktop",
    "productName": "StudyHub",
    "icon": "electron/assets/studyhub-icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/**/*",
      "node_modules/bmp-js/**/*",
      "node_modules/is-url/**/*",
      "node_modules/regenerator-runtime/**/*",
      "node_modules/wasm-feature-detect/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "electron/assets/studyhub-icon.png",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "StudyHub-${version}-${arch}.${ext}"
    }
  }
}
