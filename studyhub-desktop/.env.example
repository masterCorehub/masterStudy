# Supabase project settings. Use the publishable/anon client key only.
# Never put a service_role key in the desktop application.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Public production origin used in confirmation and password-reset links.
VITE_PUBLIC_APP_URL=https://your-domain.example

# Private Vercel server variables for the web AI endpoint. Never use VITE_ for the provider key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=configure-as-a-private-Vercel-environment-variable
GEMINI_API_KEY=configure-as-a-private-Vercel-environment-variable
GEMINI_MODEL=gemini-2.5-flash
